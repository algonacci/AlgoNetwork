---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";

// Define constants for your logos and associated data
const logos = [
  {
    imageUrl: "/clients/mayar.webp",
    projectName: "Mayar",
    companyUrl: "https://mayar.id",
  },
  {
    imageUrl: "/clients/sukabumi.png",
    projectName: "Pemkot Sukabumi",
    companyUrl: "https://sukabumikota.go.id/",
  },
  {
    imageUrl: "/clients/dinkes-dki.png",
    projectName: "Dinkes DKI",
    companyUrl: "https://dinkes.jakarta.go.id/",
  },
  {
    imageUrl: "/clients/souvia.webp",
    projectName: "Dinkes DKI",
    companyUrl: "https://www.souvia.co.id",
  },
  {
    imageUrl: "/clients/Optimaxx.png",
    projectName: "Optimaxx",
    companyUrl: "https://optimaxx.id/",
  },
  {
    imageUrl: "/clients/Denaza.jpg",
    projectName: "Denaza",
    companyUrl: "https://denaza.id",
  },
  {
    imageUrl: "/clients/YramaWidya.png",
    projectName: "Yrama Widya",
    companyUrl: "https://yrama-widya.co.id",
  },
  {
    imageUrl: "/clients/indotek.png",
    projectName: "IndotekAI",
    companyUrl: "https://indotek.ai",
  },
  {
    imageUrl: "/clients/POLTEKAD.png",
    projectName: "Politeknik Angkatan Darat",
    companyUrl: "https://poltekad.ac.id",
  },
  {
    imageUrl: "/clients/cep.png",
    projectName: "Catur Elang Perkasa",
    companyUrl: "https://caturelang.com",
  },
  {
    imageUrl: "/clients/onni.jpg",
    projectName: "Onni",
    companyUrl: "https://onni.co.id/",
  },
  {
    imageUrl: "/clients/orchid-florist.png",
    projectName: "Orchid Florist",
    companyUrl: "https://www.orchid-florist.com/",
  },
  {
    imageUrl: "/clients/whitecanvas.jpg",
    projectName: "Whitecanvas",
    companyUrl: "https://whitecanvas.id/",
  },
  {
    imageUrl: "/clients/logo-minori.webp",
    projectName: "Minori",
    companyUrl: "https://minori.co.id/",
  },
  {
    imageUrl: "/clients/mcmillan.webp",
    projectName: "McMillan Woods",
    companyUrl: "https://mcmillanwoods.co.id/",
  },
  {
    imageUrl: "/clients/solar-chapter.png",
    projectName: "Solar Chapter",
    companyUrl: "https://www.solarchapter.com/",
  },
];
---

<section>
  <Container className="space-y-8">
    <div class="text-center max-w-3xl mx-auto">
      <Title>Trusted by companies and organizations like</Title>
    </div>
    <div class="flex justify-center flex-wrap gap-4">
      {
        logos.map((logo, index) => (
          <div
            key={index}
            class="p-8 sm:p-10 rounded-xl bg-body border border-box-border group"
          >
            {logo.companyUrl ? (
              <a href={logo.companyUrl} target="_blank" rel="noopener noreferrer">
                <img
                  src={logo.imageUrl}
                  width="150"
                  height="90"
                  alt={logo.projectName}
                  class="h-9 sm:h-12 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"
                />
              </a>
            ) : (
              <img
                src={logo.imageUrl}
                width="150"
                height="90"
                alt={logo.projectName}
                class="h-9 sm:h-12 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"
              />
            )}
          </div>
        ))
      }
    </div>
  </Container>
</section>
