---
import Service from "../cards/Service.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { businessUnits } from "../../data/businessUnits";
---

<section id="services">
  <Container className="space-y-10 md:sapce-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <Title>Our Business Units</Title>
      <Paragraph>
        There are several business units that offer different products and
        services.
      </Paragraph>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        businessUnits.map((service, index) => (
          <a href={service.businessUrl} target="_blank">
            <Service title={service.title} description={service.description}>
              <span slot="icon">
                <img src={service.iconSrc} alt="" class="w-8 h-8" />
              </span>
            </Service>
          </a>
        ))
      }
    </div>
  </Container>
</section>
